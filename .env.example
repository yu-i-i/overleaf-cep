# .env のテンプレートです。`cp .env.example .env` でコピーして使ってください。
# .env には秘密値（招待トークン秘密・LLM API キー）が入ります。Git には登録せず、
# 配布・共有しないでください（.gitignore で除外済み）。

# --- Overleaf の公開設定 ---------------------------------------------------
# ブラウザーからアクセスする URL。HTTPS プロキシを噛ませる場合はその URL にします。
OVERLEAF_SITE_URL=http://localhost:8080
# Overleaf がバインドするホストアドレス。既定は loopback のみ（対外公開しない）。
OVERLEAF_LISTEN_IP=127.0.0.1
# ホスト側の公開ポート。
OVERLEAF_PORT=8080
# CE+ の自己登録ページ。既定は無効（管理者がユーザーを作成）。
OVERLEAF_ENABLE_REGISTRATION_PAGE=false

# --- 初回管理者アカウント ---------------------------------------------------
OVERLEAF_ADMIN_EMAIL=admin@example.com
# 招待トークンの署名に使う秘密値。`openssl rand -base64 32` で生成し、
# 再起動後も同じ値を維持してください。
OVERLEAF_INVITE_TOKEN_SECRET=

# --- テンプレート共有 -----------------------------------------------------
# 空欄ならサイト管理者だけが公開・管理できます。
# 別のアカウントに管理を任せる場合は、その利用者のユーザー ID を指定します。
OVERLEAF_TEMPLATES_USER_ID=

# --- ローカル LLM（OpenAI 互換 API）----------------------------------------
# 翻訳サービスが接続する OpenAI 互換サーバーのルート URL（/models,
# /chat/completions を付けた場所）。下の値は例です。実際の接続先に書き換えて
# ください。翻訳を使わない場合は空欄のままでも Overleaf 自体は起動します。
# ホストの推論サーバーを使う例: http://host.docker.internal:8000/v1
# コンテナ内の 127.0.0.1 はホストではなく、この翻訳サービス自身を指します。
LOCAL_LLM_BASE_URL=
# API キーが必要なサーバーの場合だけ設定します。この値は翻訳サービスコンテナ
# だけに渡され、ブラウザーには送信されません。
LOCAL_LLM_API_KEY=
# 翻訳サービスが LLM へ同時リクエストできる数。自ホストの GPU 負荷に合わせて調整します。
LOCAL_LLM_MAX_CONCURRENT_REQUESTS=2
# 翻訳チャンクの目安（文字数）。長い原文は段落境界でこの目安に分割されます。
TRANSLATION_CHUNK_CHARS=3600
# 1 回の翻訳に送れる原文の上限（文字数）。
TRANSLATION_MAX_DOCUMENT_CHARS=500000
