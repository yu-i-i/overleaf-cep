name: Build git-bridge (arm64)

on:
  workflow_dispatch:
    inputs:
      ref:
        description: 'overleaf/overleaf tag/branch/commit to build git-bridge from (e.g. v6.2.0)'
        required: true
        default: 'main'
      tag:
        description: 'Output image tag (e.g. 6.2.0-arm64)'
        required: true

env:
  IMAGE: ghcr.io/${{ github.repository_owner }}/git-bridge

jobs:
  build-git-bridge:
    runs-on: ubuntu-24.04-arm
    permissions:
      contents: read
      packages: write
    steps:
      - name: Checkout overleaf/overleaf at requested ref
        uses: actions/checkout@v4
        with:
          repository: overleaf/overleaf
          ref: ${{ inputs.ref }}
          sparse-checkout: |
            services/git-bridge
          sparse-checkout-cone-mode: false

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Setup Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build and push git-bridge image
        working-directory: services/git-bridge
        run: |
          docker buildx build \
            --platform linux/arm64 \
            --file Dockerfile \
            --tag ${{ env.IMAGE }}:${{ inputs.tag }} \
            --push .
